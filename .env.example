NEXT_PUBLIC_SUPABASE_URL=https://ujkaregrwrppaehvbahf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin app only (NEVER include in bia-roommate)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Google OAuth (configured in Supabase Auth dashboard)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev-only: shows the email+password sign-in form on /login.
# Leave unset / "false" in production deploys.
NEXT_PUBLIC_DEV_AUTH=false

# Product analytics (PostHog). Leave KEY unset → analytics no-ops entirely.
# Set before go-live (and ship a privacy policy first).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
